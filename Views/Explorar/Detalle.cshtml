@model GRUPAL.Models.ObjetoPerdido
@{
    ViewData["Title"] = Model.Título;
}
<div class="container py-4">
    <a asp-action="Index" class="text-decoration-none text-altoke"><i class="bi bi-arrow-left"></i> Volver a explorar</a>
    <div class="row g-4 mt-2">
        <div class="col-lg-6">
            @if (!string.IsNullOrWhiteSpace(Model.FotoUrl)) { <img src="@Model.FotoUrl" class="img-fluid rounded-4 shadow-sm w-100" alt="@Model.Título" /> }
            else { <div class="altoke-photo-placeholder rounded-4"><i class="bi bi-image"></i></div> }
        </div>
        <div class="col-lg-6">
            <span class="badge badge-categoria">@Model.Categoría</span>
            <h1 class="fw-bold mt-3">@Model.Título</h1>
            <p class="text-muted"><i class="bi bi-geo-alt"></i> @Model.Ubicacion · @Model.Fecha.ToString("dd/MM/yyyy")</p>
            <p>@Model.Descripcion</p>
            <p><strong>Estado:</strong> @Model.Estado</p>
            <p><strong>Publicado por:</strong> @Model.Usuario?.Nombre</p>
            @if (Context.Session.GetInt32("UsuarioId") == Model.UsuarioId)
            {
                <a asp-controller="ObjetosPerdidos" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-altoke">Editar publicación</a>
            }
        </div>
    </div>
</div>