@model List<GRUPAL.Models.MensajeContacto>
@{
    ViewData["Title"] = "Mensajes recibidos";
}
<div class="container py-4">
    <a asp-controller="Admin" asp-action="Index" class="small text-muted">← Administración</a>
    <h1 class="fw-bold mt-3">Mensajes de contacto</h1><p class="text-muted">Seguimiento del buzón de la comunidad. El análisis de sentimiento es orientativo y usa ML.NET.</p>
    @if (TempData["Mensaje"] is string aviso) { <div class="alert alert-info">@aviso</div> }
    <form method="post" asp-action="Reentrenar" class="mb-3">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-altoke btn-sm"><i class="bi bi-cpu me-1"></i>Reentrenar modelo</button></form>
    <form method="get" class="d-flex flex-wrap align-items-end gap-2 mb-4"><div><label class="form-label small">Estado</label><select class="form-select" name="filtro"><option value="">Todos</option><option value="Pendiente" selected="@(ViewBag.Filtro == "Pendiente")">Pendiente</option><option value="Atendido" selected="@(ViewBag.Filtro == "Atendido")">Atendido</option></select></div><div><label class="form-label small">Fecha</label><input type="date" name="fecha" class="form-control" value="@ViewBag.Fecha" /></div><button class="btn btn-altoke" type="submit">Filtrar</button></form>
    @if (!Model.Any()) { <div class="empty-state p-5 text-center text-muted">No hay mensajes para estos filtros.</div> }
    @foreach (var contacto in Model)
    {
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
            <div class="d-flex justify-content-between gap-2 flex-wrap"><div><h5 class="fw-bold mb-1">@contacto.Asunto</h5><small class="text-muted">@contacto.Nombre · @contacto.Correo · @contacto.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div><div><span class="badge @(contacto.Atendido ? "bg-success" : "bg-warning text-dark")">@(contacto.Atendido ? "Atendido" : "Pendiente")</span><span class="badge bg-light text-dark">@contacto.Sentimiento</span></div></div>
            <p class="mt-3" style="white-space:pre-wrap">@contacto.Mensaje</p>
            <form asp-action="MarcarAtendido" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@contacto.Id" /><input type="hidden" name="atendido" value="@(!contacto.Atendido ? "true" : "false")" /><button type="submit" class="btn btn-outline-altoke btn-sm">@(contacto.Atendido ? "Marcar pendiente" : "Marcar atendido")</button></form>
        </div></div>
    }
</div>
