@model List<GRUPAL.Models.ObjetoPerdido>

@{
    ViewData["Title"] = "Inicio - AlToke";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .hero-section {
        background: linear-gradient(135deg, #FF6B00 0%, #FF8533 100%);
    }
    .stats-section {
        background-color: #FFF9F5;
        border-top: 1px solid #FFE4D3;
        border-bottom: 1px solid #FFE4D3;
        border-radius: 12px;
    }
    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: #FF6B00;
        line-height: 1.2;
    }
    .section-title {
        font-weight: 700;
        color: #212529;
    }
    .card-objeto {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background-color: #ffffff;
    }
    .card-objeto:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
    }
    .card-objeto .card-img-top {
        height: 200px;
        object-fit: cover;
    }
    .badge-categoria {
        background-color: #FFF0E6;
        color: #FF6B00;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.35rem 0.65rem;
        border-radius: 50rem;
        display: inline-block;
    }
    .badge-estado-perdido {
        background-color: #dc3545;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.35rem 0.65rem;
        border-radius: 50rem;
    }
    .badge-estado-encontrado {
        background-color: #198754;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.35rem 0.65rem;
        border-radius: 50rem;
    }
    .empty-state {
        border: 2px dashed #dee2e6;
        border-radius: 16px;
        background-color: #fcfcfc;
    }
    .step-card {
        transition: transform 0.2s ease;
    }
    .step-card:hover {
        transform: translateY(-3px);
    }
</style>

@section FullWidth {
    <div class="hero-section text-center text-white py-5">
        <div class="container">
            <h1 class="display-5 fw-bold mb-3">¿Perdiste algo? Estás en el lugar correcto.</h1>
            <p class="lead mb-4">En AlToke conectamos a quienes pierden con quienes encuentran. Publica tu objeto y deja que la comunidad te ayude.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="ObjetosPerdidos" asp-action="Create" class="btn btn-light btn-lg text-dark fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Publicar objeto
                </a>
                <a asp-controller="Explorar" asp-action="Index" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-search me-1"></i> Explorar objetos
                </a>
            </div>
        </div>
    </div>
}

<!-- 2. Stats Section -->
<div class="stats-section py-4 my-4">
    <div class="container">
        <div class="row">
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <div class="stat-number">@(ViewBag.TotalObjetos ?? 0)</div>
                <div class="text-muted fw-semibold mt-1">Objetos publicados</div>
            </div>
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <div class="stat-number">@(ViewBag.ObjetosEncontrados ?? 0)</div>
                <div class="text-muted fw-semibold mt-1">Reunidos con su dueño</div>
            </div>
            <div class="col-md-4 text-center">
                <div class="stat-number">@(ViewBag.TotalUsuarios ?? 0)</div>
                <div class="text-muted fw-semibold mt-1">Usuarios activos</div>
            </div>
        </div>
    </div>
</div>

<!-- 3. Recent Objects Section -->
<div class="container py-5">
    <h2 class="section-title text-center mb-4">Objetos reportados recientemente</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var o in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card card-objeto h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(o.FotoUrl))
                        {
                            <img src="@o.FotoUrl" class="card-img-top" alt="@o.Título" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge badge-categoria">@o.Categoría</span>
                            </div>
                            <h5 class="card-title fw-bold text-dark mb-2">@o.Título</h5>
                            <p class="card-text text-muted flex-grow-1">
                                @{
                                    var desc = o.Descripcion ?? "";
                                    var descTruncada = desc.Length > 100 ? desc.Substring(0, 100) + "..." : desc;
                                }
                                @descTruncada
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3 d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>@o.Fecha.ToString("dd/MM/yyyy")
                            </small>
                            @if (o.Estado == GRUPAL.Models.EstadoObjeto.Perdido)
                            {
                                <span class="badge badge-estado-perdido">Perdido</span>
                            }
                            else
                            {
                                <span class="badge badge-estado-encontrado">Encontrado</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state text-center py-5 px-3">
            <i class="bi bi-inbox text-muted d-block mb-3" style="font-size: 4rem;"></i>
            <h5 class="fw-bold mb-2">Aún no hay objetos publicados</h5>
            <p class="text-muted mb-3">Sé el primero en publicar un objeto perdido</p>
            <a asp-controller="ObjetosPerdidos" asp-action="Create" class="btn text-white fw-semibold px-4 py-2" style="background-color: #FF6B00;">
                <i class="bi bi-plus-circle me-1"></i> Publicar objeto
            </a>
        </div>
    }
</div>

<!-- 4. 'Cómo funciona' Teaser Section -->
<div class="bg-light py-5">
    <div class="container">
        <h2 class="section-title text-center mb-5">¿Cómo funciona AlToke?</h2>
        <div class="row">
            <div class="col-md-4 text-center mb-4">
                <div class="card step-card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-pencil-square" style="font-size: 2.5rem; color: #FF6B00;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">1. Publica</h5>
                    <p class="text-muted mb-0">Describe el objeto perdido con todos los detalles posibles.</p>
                </div>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="card step-card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-people" style="font-size: 2.5rem; color: #FF6B00;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">2. Conecta</h5>
                    <p class="text-muted mb-0">La comunidad revisa y alguien puede tener tu objeto.</p>
                </div>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="card step-card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-hand-thumbs-up" style="font-size: 2.5rem; color: #FF6B00;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">3. Recupera</h5>
                    <p class="text-muted mb-0">¡Coordina la entrega y recupera lo tuyo!</p>
                </div>
            </div>
        </div>
    </div>
</div>
