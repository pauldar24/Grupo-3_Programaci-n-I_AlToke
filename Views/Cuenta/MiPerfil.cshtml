@model GRUPAL.Models.Usuario
@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Cabecera del perfil -->
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-4"
                             style="width: 80px; height: 80px; background: var(--altoke-gradient); flex-shrink: 0;">
                            <i class="bi bi-person-fill text-white" style="font-size: 2.5rem;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h3 class="fw-bold mb-1">@Model.Nombre</h3>
                            <p class="text-muted mb-0">
                                <i class="bi bi-envelope me-1"></i>@Model.Correo
                            </p>
                        </div>
                        <form asp-action="CerrarSesion" method="post">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Estadísticas -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 12px;">
                        <div class="stat-number">@Model.ObjetosPerdidos.Count</div>
                        <small class="text-muted fw-semibold">Publicaciones</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 12px;">
                        <div class="stat-number">@Model.HistoriasResueltas</div>
                        <small class="text-muted fw-semibold">Resueltas</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 12px;">
                        <div class="stat-number">@Model.BuenasAcciones</div>
                        <small class="text-muted fw-semibold">Buenas acciones</small>
                    </div>
                </div>
            </div>

            <!-- Mis publicaciones -->
            <div class="card shadow-sm border-0" style="border-radius: 16px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-collection me-2" style="color: var(--altoke-orange);"></i>
                        Mis publicaciones
                    </h5>

                    @if (Model.ObjetosPerdidos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-admin align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Categoría</th>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var obj in Model.ObjetosPerdidos)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@obj.Título</td>
                                            <td><span class="badge-categoria">@obj.Categoría</span></td>
                                            <td class="text-muted">@obj.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (obj.Estado == GRUPAL.Models.EstadoObjeto.Encontrado)
                                                {
                                                    <span class="badge-estado-encontrado">Encontrado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-estado-perdido">Perdido</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state py-4">
                            <i class="bi bi-inbox empty-icon"></i>
                            <h4>No tienes publicaciones aún</h4>
                            <p>Publica un objeto perdido para empezar.</p>
                            <a asp-controller="ObjetosPerdidos" asp-action="Create" class="btn btn-altoke">
                                <i class="bi bi-plus-lg me-1"></i>Publicar objeto
                            </a>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
