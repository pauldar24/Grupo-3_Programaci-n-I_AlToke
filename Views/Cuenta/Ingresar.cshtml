@{
    ViewData["Title"] = "Ingresar";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                             style="width: 70px; height: 70px; background-color: #FFF0E6;">
                            <i class="bi bi-box-arrow-in-right" style="font-size: 2rem; color: #FF6B00;"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Bienvenido de nuevo</h3>
                        <p class="text-muted">Ingresa a tu cuenta de AlToke</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="Ingresar">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="correo" class="form-label fw-semibold">Correo</label>
                            <input type="email" name="correo" id="correo" class="form-control" placeholder="ejemplo@usmp.pe" required />
                        </div>
                        <div class="mb-4">
                            <label for="contraseña" class="form-label fw-semibold">Contraseña</label>
                            <input type="password" name="contraseña" id="contraseña" class="form-control" placeholder="••••••••" required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg text-white" style="background-color: #FF6B00; border-color: #FF6B00;">
                                Iniciar sesión
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted">¿No tienes cuenta? <a asp-action="CrearCuenta" class="text-decoration-none" style="color: #FF6B00; font-weight: 600;">Regístrate</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
