<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlToke</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GRUPAL.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-altoke sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand navbar-brand-altoke" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-geo-alt-fill me-2"></i>AlToke
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAlToke"
                        aria-controls="navbarAlToke" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarAlToke">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Explorar" asp-action="Index">Explorar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="ComoFunciona">Cómo funciona</a>
                        </li>
                    </ul>
                    <div class="d-flex my-2 my-lg-0 mx-lg-3">
                        <a class="btn btn-altoke btn-sm" asp-controller="ObjetosPerdidos" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i>Publicar objeto
                        </a>
                    </div>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-lock me-1"></i>Admin
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cuenta" asp-action="MiPerfil">Mi perfil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cuenta" asp-action="Ingresar">Ingresar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cuenta" asp-action="CrearCuenta">Crear cuenta</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @RenderSection("FullWidth", required: false)

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-altoke mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h5 class="navbar-brand-altoke mb-2">
                        <i class="bi bi-geo-alt-fill me-2"></i>AlToke
                    </h5>
                    <p class="text-secondary small mb-3">Conectando personas con sus objetos perdidos.</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-icon" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon" aria-label="Twitter"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="social-icon" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase text-white fw-bold mb-3">Enlaces</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <a asp-controller="Explorar" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i>Explorar</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="ObjetosPerdidos" asp-action="Create"><i class="bi bi-chevron-right small me-1"></i>Publicar</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="ComoFunciona"><i class="bi bi-chevron-right small me-1"></i>Cómo funciona</a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase text-white fw-bold mb-3">Contacto</h6>
                    <ul class="list-unstyled text-secondary small mb-0">
                        <li class="mb-2">
                            <i class="bi bi-envelope me-2" style="color: var(--altoke-orange);"></i>contacto@altoke.pe
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-telephone me-2" style="color: var(--altoke-orange);"></i>+51 999 999 999
                        </li>
                    </ul>
                </div>
            </div>
            <div class="row mt-4 pt-3 border-top border-secondary text-center">
                <div class="col-12">
                    <p class="small text-secondary mb-0">&copy; 2026 AlToke. Todos los derechos reservados.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
