@{
    ViewData["Title"] = "Acceso Administrador";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                             style="width: 70px; height: 70px; background-color: #FFF0E6;">
                            <i class="bi bi-shield-lock" style="font-size: 2rem; color: #FF6B00;"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Panel de Administración</h3>
                        <p class="text-muted">Ingresa la contraseña de administrador</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="Login">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" name="password" id="password" class="form-control form-control-lg"
                                       placeholder="••••••••" required autofocus />
                            </div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg text-white" style="background-color: #FF6B00; border-color: #FF6B00;">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Volver al inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
