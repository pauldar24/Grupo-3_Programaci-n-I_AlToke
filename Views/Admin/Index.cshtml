@model List<GRUPAL.Models.ObjetoPerdido>
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="bg-dark text-white py-4 mb-4">
    <div class="container">
        <h2><i class="bi bi-shield-lock"></i> Panel de Administración</h2>
        <p class="text-muted mb-0">Gestiona los objetos y usuarios de AlToke</p>
    </div>
</div>

<div class="container mb-4">
    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link active" asp-action="Index" style="background-color: #FF6B00; color: white;">Dashboard</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-action="Objetos">Objetos</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-action="Usuarios">Usuarios</a>
        </li>
    </ul>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4" style="border-left-color: #FF6B00 !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="display-6 me-3 text-muted"><i class="bi bi-box"></i></div>
                    <div>
                        <h3 class="mb-0">@ViewBag.TotalObjetos</h3>
                        <div class="text-muted">Total Objetos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4" style="border-left-color: #FF6B00 !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="display-6 me-3 text-muted"><i class="bi bi-exclamation-triangle"></i></div>
                    <div>
                        <h3 class="mb-0">@ViewBag.ObjetosPerdidos</h3>
                        <div class="text-muted">Pendientes</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4" style="border-left-color: #198754 !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="display-6 me-3 text-muted"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <h3 class="mb-0">@ViewBag.ObjetosEncontrados</h3>
                        <div class="text-muted">Resueltos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4" style="border-left-color: #0d6efd !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="display-6 me-3 text-muted"><i class="bi bi-people"></i></div>
                    <div>
                        <h3 class="mb-0">@ViewBag.TotalUsuarios</h3>
                        <div class="text-muted">Usuarios</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Últimos reportes</h5>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Título</th>
                                <th>Categoría</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Título</td>
                                    <td>@item.Categoría</td>
                                    <td>
                                        <span class="badge @(item.Estado == GRUPAL.Models.EstadoObjeto.Perdido ? "bg-danger" : "bg-success")">
                                            @item.Estado
                                        </span>
                                    </td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@(item.Usuario?.Nombre ?? "Desconocido")</td>
                                    <td>
                                        <a asp-controller="Admin" asp-action="EditarObjeto" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Editar</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox display-4 d-block mb-3"></i>
                    <p>No hay objetos registrados aún.</p>
                </div>
            }
        </div>
    </div>
</div>
