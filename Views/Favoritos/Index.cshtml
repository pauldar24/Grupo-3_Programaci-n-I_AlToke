@model List<GRUPAL.Models.ObjetoPerdido>
@using GRUPAL.Models
@{
    ViewData["Title"] = "Mis favoritos";
    var recomendados = ViewBag.Recomendados as List<ObjetoPerdido> ?? new();
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div><h1 class="fw-bold mb-1"><i class="bi bi-bookmark-heart text-altoke me-2"></i>Mis favoritos</h1><p class="text-muted mb-0">Guarda los avisos que quieras consultar después.</p></div>
        <a asp-controller="Explorar" asp-action="Index" class="btn btn-outline-altoke">Explorar objetos</a>
    </div>
    @if (!Model.Any()) { <div class="empty-state text-center p-5 text-muted"><i class="bi bi-bookmark display-4"></i><h4 class="mt-3">Aún no guardas avisos</h4><p>Encuentra publicaciones que te interesen y guárdalas desde su ficha.</p></div> }
    else
    {
        <div class="row g-3">
            @foreach (var objeto in Model)
            {
                <div class="col-md-6 col-lg-4"><div class="card card-objeto shadow-sm border-0 h-100">
                    @if (!string.IsNullOrEmpty(objeto.FotoUrl)) { <img class="card-img-top" src="@objeto.FotoUrl" alt="@objeto.Título" /> }
                    else { <div class="altoke-photo-placeholder"><i class="bi bi-image"></i></div> }
                    <div class="card-body d-flex flex-column"><span class="badge badge-categoria align-self-start">@objeto.Categoría</span><h5 class="mt-2">@objeto.Título</h5><small class="text-muted mb-3">@objeto.Ubicacion</small><div class="mt-auto d-flex gap-2"><a asp-controller="Explorar" asp-action="Detalle" asp-route-id="@objeto.Id" class="btn btn-altoke btn-sm">Ver aviso</a>
                    <form asp-action="Alternar" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@objeto.Id" /><input type="hidden" name="volver" value="favoritos" /><button type="submit" class="btn btn-outline-secondary btn-sm">Quitar</button></form></div></div>
                </div></div>
            }
        </div>
    }
    @if (recomendados.Any())
    {
        <h3 class="fw-bold mt-5 mb-3">Recomendados para ti</h3>
        <div class="row g-3">@foreach (var objeto in recomendados) { <div class="col-md-4"><a asp-controller="Explorar" asp-action="Detalle" asp-route-id="@objeto.Id" class="card p-3 border-0 shadow-sm text-decoration-none text-dark h-100"><small class="text-altoke fw-semibold">@objeto.Categoría</small><strong>@objeto.Título</strong><span class="text-muted small">@objeto.Ubicacion</span></a></div> }</div>
    }
</div>
